COMPOSE_PROJECT_NAME=qs-local
REDIS_IMAGE=redis:7.4-alpine
POSTGRES_IMAGE=postgres:18.4
RUSTFS_IMAGE=rustfs/rustfs:latest
NGINX_IMAGE=nginx:stable-alpine

REDIS_PORT=6379
POSTGRES_PORT=5432
RUSTFS_API_PORT=9000
RUSTFS_CONSOLE_PORT=9001
NGINX_PORT=8080

POSTGRES_DB=qs
POSTGRES_USER=qs
RUSTFS_ACCESS_KEY=qsadmin
# start.cmd replaces these markers with separate random secrets in .env.
REDIS_PASSWORD=__GENERATE_REDIS_PASSWORD__
POSTGRES_PASSWORD=__GENERATE_POSTGRES_PASSWORD__
RUSTFS_SECRET_KEY=__GENERATE_RUSTFS_SECRET_KEY__
