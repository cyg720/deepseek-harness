  "cards": [
    {
      "dot": "cyan",
      "title": "先记住 1：它是“装起来”的",
      "items": [
        "所有受支持的 Node 应用都由 dsh CLI 加一个具名 profile 启动",
        "Bundle 和 Patch 按顺序合并，最终得到一棵 Cordis 插件树"
      ]
    },
    {
      "dot": "emerald",
      "title": "先记住 2：它是“记着跑”的",
      "items": [
        "Agent loop 组装提示词、调用模型、分发工具，直到轮次结束",
        "模型看到的事必须写入 SessionEvent；回放、UI 和恢复都从日志派生"
      ]
    },
    {
      "dot": "violet",
      "title": "先记住 3：它是“换能力不换主干”的",
      "items": [
        "一项完整能力由 Service Definition、Provider 和 Consumer 组成",
        "新行为优先挂到服务、事件或工具扩展点，而不是修改 agent-loop"
      ]
    }
  ]
